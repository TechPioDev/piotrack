APP_NAME=Piotrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Proxies whose X-Forwarded-* headers may be believed. Leave empty when browsers
# reach the app directly — trusting an absent proxy lets any client spoof its own
# IP and scheme. Behind a load balancer or CDN, list addresses/CIDR ranges
# (comma-separated), or "*" when that proxy is the only way in.
TRUSTED_PROXIES=

# Require every signed-in account to complete TOTP enrolment before it can reach
# anything else. Leave false on a private network; turn it on before the login
# page is reachable from the internet.
REQUIRE_TWO_FACTOR=false

# Language-model provider (ADR-0008): fixture|anthropic|openai|gemini. The
# platform console (Platform -> AI Provider) can override all of these at
# runtime; env values are the fallback when nothing is saved there.
AI_DRIVER=fixture
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: cookies must only travel over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BILLING_PROVIDER=manual
BILLING_MANUAL_WEBHOOK_SECRET=local-manual-secret
